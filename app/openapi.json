  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId",
        "description": "Session-based authentication via cookies"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "John Smith" },
          "email": { "type": "string", "format": "email", "example": "john.smith@email.com" },
          "phone": { "type": "string", "example": "555-0101" },
          "role": { "type": "string", "enum": ["Account Holder", "Bank Teller", "Bank Manager"] },
          "status": { "type": "string", "enum": ["active", "inactive", "suspended"] },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "email", "role", "status", "createdAt"]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "accountNumber": { "type": "string", "example": "1001000123" },
          "accountType": { "type": "string", "enum": ["checking", "savings", "business"] },
          "balance": { "type": "string", "example": "2750.50" },
          "status": { "type": "string", "enum": ["active", "closed", "frozen"] },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "accountNumber", "accountType", "balance", "status", "createdAt"]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "fromAccountId": { "type": "string", "format": "uuid", "nullable": true },
          "toAccountId": { "type": "string", "format": "uuid", "nullable": true },
          "type": { "type": "string", "enum": ["deposit", "withdrawal", "transfer", "fee"] },
          "amount": { "type": "string", "example": "500.00" },
          "description": { "type": "string", "example": "Monthly savings transfer" },
          "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
          "processedBy": { "type": "string", "format": "uuid", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "type", "amount", "description", "status", "createdAt"]
      },
      "Loan": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["personal", "auto", "home", "business"] },
          "amount": { "type": "string", "example": "15000.00" },
          "interestRate": { "type": "string", "example": "8.50" },
          "termMonths": { "type": "integer", "example": 36 },
          "monthlyPayment": { "type": "string", "example": "472.81" },
          "remainingBalance": { "type": "string", "example": "15000.00" },
          "status": { "type": "string", "enum": ["pending", "offered", "accepted", "approved", "rejected", "active", "paid_off"] },
          "approvedBy": { "type": "string", "format": "uuid", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "type", "amount", "interestRate", "termMonths", "monthlyPayment", "remainingBalance", "status", "createdAt"]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Emma Davis" },
          "email": { "type": "string", "format": "email", "example": "emma.davis@email.com" },
          "phone": { "type": "string", "example": "555-0104" },
          "role": { "type": "string", "enum": ["Account Holder", "Bank Teller", "Bank Manager"] },
