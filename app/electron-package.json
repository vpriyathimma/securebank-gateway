{
  "name": "securebank-desktop",
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "license": "MIT",
  "scripts": {
    "electron": "NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux", 
    "build:all": "npm run build && electron-builder --mac --linux",
    "pack": "npm run build && electron-builder --dir"
  }
}